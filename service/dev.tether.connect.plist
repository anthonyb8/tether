<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keeps tether connect running for this user on a Mac.
    cp dev.tether.connect.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.tether.connect.plist
  Logs: ~/Library/Logs/tether-connect.log
  launchd expands neither ~ nor $HOME, so a shell finds the binary and the log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.tether.connect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>exec "$HOME/.local/bin/tether" connect >>"$HOME/Library/Logs/tether-connect.log" 2>&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
